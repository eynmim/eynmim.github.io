GOOGLE_API_KEY=AIza...

# Optional overrides:
# MODEL=gemini-2.5-flash            # default; good quality, free tier
# MODEL=gemini-2.5-flash-lite       # cheaper/faster, higher free-tier limits
# MODEL=gemini-2.5-pro              # best quality, lower free-tier limits

# CV_FILE=../../public/Ali_Mansouri_CV.md
# PORT=5577
# MAX_PARALLEL=3                    # Gemini free tier is rate-limited

# MentorMatch (mentor outreach) — optional:
# OUTREACH_MODEL=gemini-2.5-flash   # keep flash (not lite) so drafts keep the numeric achievement
# FOLLOWUP_DAYS=35                  # days after "sent" before a contact shows as due
# OUTREACH_CSV=./outreach.csv       # tracker; gitignored (real names)
